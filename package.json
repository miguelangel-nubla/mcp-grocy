{
  "name": "mcp-grocy",
  "version": "2.7.1",
  "description": "Model Context Protocol (MCP) server for Grocy integration",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "name": "mcp-grocy",
    "access": "public"
  },
  "bin": {
    "mcp-grocy": "./build/main.js"
  },
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/build.js",
    "build": "tsc",
    "prepack": "npm run build",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "start": "node build/main.js",
    "dev": "npm run build && node build/main.js",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/main.js",
    "test": "vitest run",
    "test:mcp-inspector": "bash scripts/run-mcp-inspector.sh",
    "dev:mcp-tef": "bash scripts/run-mcp-tef.sh",
    "report:mcp-tef": "bash scripts/mcp-tef-report.sh",
    "start:mcp-http-test": "bash scripts/start-mcp-http-for-tests.sh",
    "stop:mcp-http-test": "bash scripts/stop-mcp-http-for-tests.sh",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-tools": "node scripts/check-tools.js",
    "validate-release": "node scripts/check-tools.js --validate-release",
    "update-api-docs": "node scripts/fetch-grocy-api.js",
    "verify-release-config": "node scripts/verify-release-config.js",
    "prepare-dev-release": "node scripts/prepare-dev-release.js",
    "prepare-dev-release:patch": "node scripts/prepare-dev-release.js --patch",
    "prepare-dev-release:minor": "node scripts/prepare-dev-release.js --minor",
    "prepare-dev-release:major": "node scripts/prepare-dev-release.js --major",
    "prepare-dev-release:dryrun": "node scripts/prepare-dev-release.js --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "grocy",
    "mcp",
    "rest",
    "api",
    "http",
    "testing",
    "cline",
    "development",
    "typescript"
  ],
  "author": "miguelangel-nubla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelangel-nubla/mcp-grocy.git"
  },
  "bugs": {
    "url": "https://github.com/miguelangel-nubla/mcp-grocy/issues"
  },
  "homepage": "https://github.com/miguelangel-nubla/mcp-grocy#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "config": {
    "supportedGrocyVersion": "4.7.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
