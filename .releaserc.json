{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": true,
        "pkgRoot": "."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo \"Running scripts/build.js to update generated version files...\" && node scripts/build.js && npx tsc && echo \"Staging changed files...\" && git add CHANGELOG.md && git add -f src/version.ts build/version.js"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "CHANGELOG.md", "src/version.ts", "build/version.js"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [],
        "failCommentCondition": false
      }
    ]
  ]
}
